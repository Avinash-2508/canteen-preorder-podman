# nginx turns this template into /etc/nginx/conf.d/default.conf at startup,
# replacing ${API_HOST}, ${API_PORT} and ${NGINX_LOCAL_RESOLVERS}.

server {
    listen 80;
    server_name _;

    # Podman's DNS server on the network (read from /etc/resolv.conf).
    # Looking the backend up per request means nginx still starts if the API
    # container is not up yet, and follows it if it is recreated with a new IP.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # React app (static files from the build stage)
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri /index.html;
    }

    # Forward API calls to the Node.js container over the Podman network.
    location /api/ {
        set $api_upstream http://${API_HOST}:${API_PORT};
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 3s;
    }
}
